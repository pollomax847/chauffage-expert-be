{
    "framework": "nextjs",
    "outputDirectory": "build/web",
    "buildCommand": "./build_web.sh",
    "installCommand": "flutter pub get",
    "env": {
        "production": "true"
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/assets/(.*)",ce": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",   "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"       "value": "public, max-age=31536000, immutable"
                }      }
            ]   ]
        },
        {
            "source": "/favicon.png",ce": "/favicon.png",
            "headers": [
                {
                    "key": "Cache-Control",   "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"       "value": "public, max-age=31536000, immutable"
                },      },
                {       {
                    "key": "Content-Type",ype",
                    "value": "image/png"ue": "image/png"
                }
            ]
        },
        {
            "source": "/favicon.ico",ce": "/favicon.ico",
            "headers": [
                {
                    "key": "Cache-Control",   "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"       "value": "public, max-age=31536000, immutable"
                },      },
                {       {
                    "key": "Content-Type",ype",
                    "value": "image/x-icon"ue": "image/x-icon"
                }
            ]
        }
    ],
    "builds": [
        {
            "src": "build/web/**",
            "use": "@vercel/static": "@vercel/static"
        }
    ],
    "routes": [outes": [
        {
            "src": "/(.*)",   "handle": "filesystem"
            "dest": "/index.html"
        }
    ]   "src": "/(.*)",
}